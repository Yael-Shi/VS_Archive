# =====================================
# VS-Archive Application Environment
# =====================================

# ---------- Django (local dev; set DJANGO_ENV=local in shell) ----------
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-dev-only-change-me
ALLOWED_HOSTS=127.0.0.1 localhost
# Optional ngrok CSRF (DEBUG=1 defaults include https://*.ngrok-free.dev):
# CSRF_TRUSTED_ORIGINS=https://your-subdomain.ngrok-free.dev

# ---------- Hybrid HTR Logic ----------
GEMINI_CONFIDENCE_THRESHOLD=0.55
MIN_TEXT_LENGTH=30

MAX_RETRIES=2
RETRY_DELAY_SECONDS_1=60
RETRY_DELAY_SECONDS_2=300

# ---------- Gemini ----------
GEMINI_API_KEY=REPLACE_ME
# Hebrew printed OCR route (default: gemini-3.1-flash-lite)
GEMINI_HEBREW_PRINTED_MODEL=gemini-3.1-flash-lite

# ---------- Transkribus ----------
ENABLE_TRANSKRIBUS_HEBREW_HANDWRITTEN=
TRANSKRIBUS_DEV_UPLOAD_MODE=
TRANSKRIBUS_USE_EXISTING_SERVER_DOCUMENT=
TRANSKRIBUS_COLLECTION_ID=
TRANSKRIBUS_MODEL_ID=

# Use ONE approach for authentication:

# Option A - Token
TRANSKRIBUS_API_TOKEN=

# Option B - Username/Password
TRANSKRIBUS_USERNAME=
TRANSKRIBUS_PASSWORD=

# ---------- Reporting ----------
REPORT_WINDOW_START=07:00
REPORT_SEND_TIME=23:00

FREE_TIER_ALERT_PCT=80
GEMINI_FREE_DAILY_REQUEST_LIMIT=200
GEMINI_FREE_DAILY_IMAGE_LIMIT=200
TRANSKRIBUS_FREE_MONTHLY_CREDITS=50

# ---------- Email (Gmail SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# ---------- Antigravity (Gemini Interactions; Arabic printed OCR) ----------
# Default false = safe rollout state (ar+PRINTED stays on Gemini). See docs/ocr-routing-reference.md.
ENABLE_ANTIGRAVITY_ARABIC_PRINTED=false
# Worker-only execution flag (code default false). Do not set on web.
# ENABLE_ANTIGRAVITY_ARABIC_PRINTED_BANDED=false
# Defaults to antigravity-preview-05-2026 when unset (see antigravity_defaults.py).
ANTIGRAVITY_AGENT_ID=antigravity-preview-05-2026

# ---------- Feature Flags ----------
ENABLE_HYBRID_HTR=true
ENABLE_DAILY_REPORT=true

# ---------- Logging ----------
LOG_LEVEL=INFO
